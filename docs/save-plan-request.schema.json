{
  "$defs": {
    "AnalysisGoal": {
      "additionalProperties": false,
      "properties": {
        "analysis_object": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "pattern": "[\\s\\S]*\\S[\\s\\S]*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Analysis Object"
        },
        "business_goal": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "pattern": "[\\s\\S]*\\S[\\s\\S]*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Business Goal"
        },
        "decision_goal": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "pattern": "[\\s\\S]*\\S[\\s\\S]*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Decision Goal"
        }
      },
      "required": [
        "analysis_object",
        "business_goal",
        "decision_goal"
      ],
      "title": "AnalysisGoal",
      "type": "object"
    },
    "AnalysisMode": {
      "enum": [
        "goal_driven",
        "exploratory",
        "undetermined"
      ],
      "title": "AnalysisMode",
      "type": "string"
    },
    "AnalysisPlan": {
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "minLength": 1,
          "title": "Dataset Id",
          "type": "string"
        },
        "dataset_version": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Dataset Version",
          "type": "string"
        },
        "plan_id": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Plan Id",
          "type": "string"
        },
        "plan_version": {
          "minimum": 1,
          "title": "Plan Version",
          "type": "integer"
        },
        "tasks": {
          "items": {
            "$ref": "#/$defs/AnalysisTask"
          },
          "maxItems": 10,
          "title": "Tasks",
          "type": "array"
        },
        "core_requirements": {
          "items": {
            "$ref": "#/$defs/CoreRequirement"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Core Requirements",
          "type": "array"
        }
      },
      "required": [
        "dataset_id",
        "dataset_version",
        "plan_id",
        "plan_version",
        "tasks",
        "core_requirements"
      ],
      "title": "AnalysisPlan",
      "type": "object"
    },
    "AnalysisStep": {
      "additionalProperties": false,
      "properties": {
        "step_id": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Step Id",
          "type": "string"
        },
        "operation": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Operation",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "step_id",
        "operation",
        "params"
      ],
      "title": "AnalysisStep",
      "type": "object"
    },
    "AnalysisTask": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Task Id",
          "type": "string"
        },
        "title": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        },
        "business_question": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Business Question",
          "type": "string"
        },
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2"
          ],
          "title": "Priority",
          "type": "string"
        },
        "priority_reason": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Priority Reason",
          "type": "string"
        },
        "requirement_ids": {
          "items": {
            "maxLength": 120,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Requirement Ids",
          "type": "array"
        },
        "depends_on": {
          "items": {
            "maxLength": 120,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "missing_inputs": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 10,
          "title": "Missing Inputs",
          "type": "array"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/AnalysisStep"
          },
          "maxItems": 20,
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "task_id",
        "title",
        "business_question",
        "priority",
        "priority_reason",
        "requirement_ids",
        "depends_on",
        "steps"
      ],
      "title": "AnalysisTask",
      "type": "object"
    },
    "CoreRequirement": {
      "additionalProperties": false,
      "properties": {
        "requirement_id": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Requirement Id",
          "type": "string"
        },
        "description": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "description"
      ],
      "title": "CoreRequirement",
      "type": "object"
    },
    "IntentConstraints": {
      "additionalProperties": false,
      "properties": {
        "time_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/UnverifiedConstraint"
            },
            {
              "type": "null"
            }
          ]
        },
        "filters": {
          "items": {
            "$ref": "#/$defs/UnverifiedConstraint"
          },
          "title": "Filters",
          "type": "array"
        },
        "metric_requirements": {
          "items": {
            "$ref": "#/$defs/UnverifiedConstraint"
          },
          "title": "Metric Requirements",
          "type": "array"
        },
        "analysis_limits": {
          "items": {
            "$ref": "#/$defs/UnverifiedConstraint"
          },
          "title": "Analysis Limits",
          "type": "array"
        }
      },
      "required": [
        "time_range",
        "filters",
        "metric_requirements",
        "analysis_limits"
      ],
      "title": "IntentConstraints",
      "type": "object"
    },
    "ParsedIntent": {
      "additionalProperties": false,
      "properties": {
        "analysis_mode": {
          "$ref": "#/$defs/AnalysisMode"
        },
        "next_action": {
          "enum": [
            "proceed",
            "clarify"
          ],
          "title": "Next Action",
          "type": "string"
        },
        "analysis_goal": {
          "$ref": "#/$defs/AnalysisGoal"
        },
        "constraints": {
          "$ref": "#/$defs/IntentConstraints"
        },
        "uncertainties": {
          "items": {
            "$ref": "#/$defs/Uncertainty"
          },
          "title": "Uncertainties",
          "type": "array"
        },
        "clarification_questions": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "pattern": "[\\s\\S]*\\S[\\s\\S]*",
            "type": "string"
          },
          "maxItems": 3,
          "title": "Clarification Questions",
          "type": "array"
        }
      },
      "required": [
        "analysis_mode",
        "next_action",
        "analysis_goal",
        "constraints",
        "uncertainties",
        "clarification_questions"
      ],
      "title": "ParsedIntent",
      "type": "object"
    },
    "Uncertainty": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "[\\s\\S]*\\S[\\s\\S]*",
          "title": "Id",
          "type": "string"
        },
        "issue": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "[\\s\\S]*\\S[\\s\\S]*",
          "title": "Issue",
          "type": "string"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "[\\s\\S]*\\S[\\s\\S]*",
          "title": "Reason",
          "type": "string"
        },
        "action": {
          "enum": [
            "clarify",
            "defer",
            "annotate"
          ],
          "title": "Action",
          "type": "string"
        },
        "resolve_at": {
          "enum": [
            "before_planning",
            "plan_approval",
            "before_execution"
          ],
          "title": "Resolve At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "issue",
        "reason",
        "action",
        "resolve_at"
      ],
      "title": "Uncertainty",
      "type": "object"
    },
    "UnverifiedConstraint": {
      "additionalProperties": false,
      "properties": {
        "raw_text": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "[\\s\\S]*\\S[\\s\\S]*",
          "title": "Raw Text",
          "type": "string"
        },
        "validation_status": {
          "const": "unverified",
          "title": "Validation Status",
          "type": "string"
        }
      },
      "required": [
        "raw_text",
        "validation_status"
      ],
      "title": "UnverifiedConstraint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "expected_revision": {
      "minimum": 0,
      "title": "Expected Revision",
      "type": "integer"
    },
    "plan": {
      "$ref": "#/$defs/AnalysisPlan"
    },
    "intent": {
      "$ref": "#/$defs/ParsedIntent"
    }
  },
  "required": [
    "expected_revision",
    "plan",
    "intent"
  ],
  "title": "SavePlanRequest",
  "type": "object"
}
