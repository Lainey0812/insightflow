{
  "$defs": {
    "AnalysisGoal": {
      "additionalProperties": false,
      "properties": {
        "analysis_object": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "pattern": "[\\s\\S]*\\S[\\s\\S]*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Analysis Object"
        },
        "business_goal": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "pattern": "[\\s\\S]*\\S[\\s\\S]*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Business Goal"
        },
        "decision_goal": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "pattern": "[\\s\\S]*\\S[\\s\\S]*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Decision Goal"
        }
      },
      "required": [
        "analysis_object",
        "business_goal",
        "decision_goal"
      ],
      "title": "AnalysisGoal",
      "type": "object"
    },
    "AnalysisMode": {
      "enum": [
        "goal_driven",
        "exploratory",
        "undetermined"
      ],
      "title": "AnalysisMode",
      "type": "string"
    },
    "AnalysisPlan": {
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "minLength": 1,
          "title": "Dataset Id",
          "type": "string"
        },
        "dataset_version": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Dataset Version",
          "type": "string"
        },
        "plan_id": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Plan Id",
          "type": "string"
        },
        "plan_version": {
          "minimum": 1,
          "title": "Plan Version",
          "type": "integer"
        },
        "tasks": {
          "items": {
            "$ref": "#/$defs/AnalysisTask"
          },
          "maxItems": 10,
          "title": "Tasks",
          "type": "array"
        },
        "core_requirements": {
          "items": {
            "$ref": "#/$defs/CoreRequirement"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Core Requirements",
          "type": "array"
        }
      },
      "required": [
        "dataset_id",
        "dataset_version",
        "plan_id",
        "plan_version",
        "tasks",
        "core_requirements"
      ],
      "title": "AnalysisPlan",
      "type": "object"
    },
    "AnalysisStep": {
      "additionalProperties": false,
      "properties": {
        "step_id": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Step Id",
          "type": "string"
        },
        "operation": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Operation",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "step_id",
        "operation",
        "params"
      ],
      "title": "AnalysisStep",
      "type": "object"
    },
    "AnalysisTask": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Task Id",
          "type": "string"
        },
        "title": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        },
        "business_question": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Business Question",
          "type": "string"
        },
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2"
          ],
          "title": "Priority",
          "type": "string"
        },
        "priority_reason": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Priority Reason",
          "type": "string"
        },
        "requirement_ids": {
          "items": {
            "maxLength": 120,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Requirement Ids",
          "type": "array"
        },
        "depends_on": {
          "items": {
            "maxLength": 120,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "missing_inputs": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 10,
          "title": "Missing Inputs",
          "type": "array"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/AnalysisStep"
          },
          "maxItems": 20,
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "task_id",
        "title",
        "business_question",
        "priority",
        "priority_reason",
        "requirement_ids",
        "depends_on",
        "steps"
      ],
      "title": "AnalysisTask",
      "type": "object"
    },
    "CoreRequirement": {
      "additionalProperties": false,
      "properties": {
        "requirement_id": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Requirement Id",
          "type": "string"
        },
        "description": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "description"
      ],
      "title": "CoreRequirement",
      "type": "object"
    },
    "DatasetRef": {
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "minLength": 1,
          "title": "Dataset Id",
          "type": "string"
        },
        "dataset_version": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Dataset Version",
          "type": "string"
        }
      },
      "required": [
        "dataset_id",
        "dataset_version"
      ],
      "title": "DatasetRef",
      "type": "object"
    },
    "ExecutedTask": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Task Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "success",
            "failed",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResultTable"
            },
            {
              "type": "null"
            }
          ]
        },
        "effective_row_count": {
          "minimum": 0,
          "title": "Effective Row Count",
          "type": "integer"
        },
        "valid_sample_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Valid Sample Count"
        },
        "sample_definition": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Sample Definition",
          "type": "string"
        },
        "scope": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Scope",
          "type": "string"
        },
        "calculation": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Calculation",
          "type": "string"
        },
        "failure_reason": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Failure Reason"
        },
        "result_id": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Id"
        },
        "result_ref": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Ref"
        },
        "row_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Count"
        },
        "execution_metadata": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskExecutionMetadata"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "task_id",
        "status",
        "result",
        "effective_row_count",
        "valid_sample_count",
        "sample_definition",
        "scope",
        "calculation",
        "failure_reason"
      ],
      "title": "ExecutedTask",
      "type": "object"
    },
    "ExecutionError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Message",
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "step_id": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step Id"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ExecutionError",
      "type": "object"
    },
    "ExecutionResultV1": {
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "minLength": 1,
          "title": "Dataset Id",
          "type": "string"
        },
        "dataset_version": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Dataset Version",
          "type": "string"
        },
        "execution_id": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Execution Id",
          "type": "string"
        },
        "plan_id": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Plan Id",
          "type": "string"
        },
        "plan_version": {
          "minimum": 1,
          "title": "Plan Version",
          "type": "integer"
        },
        "approved_plan_version": {
          "minimum": 1,
          "title": "Approved Plan Version",
          "type": "integer"
        },
        "execution_status": {
          "enum": [
            "success",
            "partial_success",
            "failed"
          ],
          "title": "Execution Status",
          "type": "string"
        },
        "source": {
          "enum": [
            "engine",
            "imported",
            "mock"
          ],
          "title": "Source",
          "type": "string"
        },
        "producer": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Producer",
          "type": "string"
        },
        "session_id": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "execution_request_id": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Request Id"
        },
        "approval_id": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approval Id"
        },
        "started_at": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "finished_at": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "duration_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "result_view": {
          "anyOf": [
            {
              "enum": [
                "preview",
                "complete"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result View"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/ExecutionError"
          },
          "title": "Errors",
          "type": "array"
        },
        "warnings": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "tasks": {
          "items": {
            "$ref": "#/$defs/ExecutedTask"
          },
          "maxItems": 10,
          "title": "Tasks",
          "type": "array"
        }
      },
      "required": [
        "dataset_id",
        "dataset_version",
        "execution_id",
        "plan_id",
        "plan_version",
        "approved_plan_version",
        "execution_status",
        "source",
        "producer",
        "tasks"
      ],
      "title": "ExecutionResultV1",
      "type": "object"
    },
    "IntentArtifact": {
      "additionalProperties": false,
      "properties": {
        "analysis_mode": {
          "$ref": "#/$defs/AnalysisMode"
        },
        "next_action": {
          "enum": [
            "proceed",
            "clarify"
          ],
          "title": "Next Action",
          "type": "string"
        },
        "analysis_goal": {
          "$ref": "#/$defs/AnalysisGoal"
        },
        "constraints": {
          "$ref": "#/$defs/IntentConstraints"
        },
        "uncertainties": {
          "items": {
            "$ref": "#/$defs/Uncertainty"
          },
          "title": "Uncertainties",
          "type": "array"
        },
        "clarification_questions": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "pattern": "[\\s\\S]*\\S[\\s\\S]*",
            "type": "string"
          },
          "maxItems": 3,
          "title": "Clarification Questions",
          "type": "array"
        },
        "user_query": {
          "title": "User Query",
          "type": "string"
        },
        "clarification_answers": {
          "items": {
            "type": "string"
          },
          "title": "Clarification Answers",
          "type": "array"
        },
        "dataset_ref": {
          "$ref": "#/$defs/DatasetRef"
        },
        "parse_origin": {
          "enum": [
            "llm",
            "input_guard"
          ],
          "title": "Parse Origin",
          "type": "string"
        },
        "llm": {
          "anyOf": [
            {
              "$ref": "#/$defs/LLMMetadata"
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "parser_version": {
          "default": "1.0",
          "enum": [
            "1.0",
            "1.1"
          ],
          "title": "Parser Version",
          "type": "string"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "llm_attempts": {
          "anyOf": [
            {
              "maximum": 3,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Llm Attempts"
        },
        "parse_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parse Id"
        }
      },
      "required": [
        "analysis_mode",
        "next_action",
        "analysis_goal",
        "constraints",
        "uncertainties",
        "clarification_questions",
        "user_query",
        "clarification_answers",
        "dataset_ref",
        "parse_origin",
        "llm",
        "provenance"
      ],
      "title": "IntentArtifact",
      "type": "object"
    },
    "IntentConstraints": {
      "additionalProperties": false,
      "properties": {
        "time_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/UnverifiedConstraint"
            },
            {
              "type": "null"
            }
          ]
        },
        "filters": {
          "items": {
            "$ref": "#/$defs/UnverifiedConstraint"
          },
          "title": "Filters",
          "type": "array"
        },
        "metric_requirements": {
          "items": {
            "$ref": "#/$defs/UnverifiedConstraint"
          },
          "title": "Metric Requirements",
          "type": "array"
        },
        "analysis_limits": {
          "items": {
            "$ref": "#/$defs/UnverifiedConstraint"
          },
          "title": "Analysis Limits",
          "type": "array"
        }
      },
      "required": [
        "time_range",
        "filters",
        "metric_requirements",
        "analysis_limits"
      ],
      "title": "IntentConstraints",
      "type": "object"
    },
    "LLMMetadata": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model"
        },
        "is_mock": {
          "title": "Is Mock",
          "type": "boolean"
        }
      },
      "required": [
        "provider",
        "model",
        "is_mock"
      ],
      "title": "LLMMetadata",
      "type": "object"
    },
    "LogicalType": {
      "enum": [
        "empty",
        "boolean",
        "integer",
        "number",
        "date",
        "datetime",
        "time",
        "text",
        "mixed"
      ],
      "title": "LogicalType",
      "type": "string"
    },
    "ParsedIntent": {
      "additionalProperties": false,
      "properties": {
        "analysis_mode": {
          "$ref": "#/$defs/AnalysisMode"
        },
        "next_action": {
          "enum": [
            "proceed",
            "clarify"
          ],
          "title": "Next Action",
          "type": "string"
        },
        "analysis_goal": {
          "$ref": "#/$defs/AnalysisGoal"
        },
        "constraints": {
          "$ref": "#/$defs/IntentConstraints"
        },
        "uncertainties": {
          "items": {
            "$ref": "#/$defs/Uncertainty"
          },
          "title": "Uncertainties",
          "type": "array"
        },
        "clarification_questions": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "pattern": "[\\s\\S]*\\S[\\s\\S]*",
            "type": "string"
          },
          "maxItems": 3,
          "title": "Clarification Questions",
          "type": "array"
        }
      },
      "required": [
        "analysis_mode",
        "next_action",
        "analysis_goal",
        "constraints",
        "uncertainties",
        "clarification_questions"
      ],
      "title": "ParsedIntent",
      "type": "object"
    },
    "Provenance": {
      "properties": {
        "source": {
          "default": "mock",
          "enum": [
            "mock",
            "uploaded",
            "llm",
            "input_guard"
          ],
          "title": "Source",
          "type": "string"
        },
        "dataset": {
          "default": "insightflow-demo-v1",
          "title": "Dataset",
          "type": "string"
        },
        "dataset_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Version"
        },
        "plan_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Version"
        },
        "notice": {
          "default": "Mock 示例，非上传文件分析结果",
          "title": "Notice",
          "type": "string"
        }
      },
      "title": "Provenance",
      "type": "object"
    },
    "ResultColumn": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Field",
          "type": "string"
        },
        "label": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Label",
          "type": "string"
        },
        "logical_type": {
          "$ref": "#/$defs/LogicalType"
        },
        "role": {
          "enum": [
            "dimension",
            "metric"
          ],
          "title": "Role",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
