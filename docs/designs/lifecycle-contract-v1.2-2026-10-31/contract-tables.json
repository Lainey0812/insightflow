  "acceptance_cases": [
    {
      "id": "A01",
      "status": "目标",
      "given": "仅control=COMPLETED，无可读取ExecutionResult",
      "expected": "unknown/record_missing；禁止succeeded"
    },
    {
      "id": "A02",
      "status": "目标",
      "given": "Engine.partial_success，Report.generating",
      "expected": "partially_succeeded/reporting；execution_partial保留；非running覆盖失败"
    },
    {
      "id": "A03",
      "status": "目标",
      "given": "Engine.success，Report.failed",
      "expected": "partially_succeeded/finished；report_failed+report_not_delivered"
    },
    {
      "id": "A04",
      "status": "目标",
      "given": "Engine.success，交付complete但goal_coverage=partial",
      "expected": "partially_succeeded/delivered；不能succeeded"
    },
    {
      "id": "A05",
      "status": "目标",
      "given": "Engine.success，plan coverage=partial但report goal coverage=complete",
      "expected": "unknown/inconsistent；不能伪造完整覆盖"
    },
    {
      "id": "A06",
      "status": "目标",
      "given": "Root.complete，删除任务或重新执行",
      "expected": "拒绝；原Root/Plan/Approval/Execution/Report均不修改"
    },
    {
      "id": "A07",
      "status": "现有",
      "given": "legacy Session.COMPLETED，合法删除任务",
      "expected": "仍按原服务创建新版本并AWAITING_APPROVAL；不移除兼容路径"
    },
    {
      "id": "A08",
      "status": "目标",
      "given": "Report.unavailable，用户Retry",
      "expected": "不提供Retry；重复queue仅查询原记录；不发LLM"
    },
    {
      "id": "A09",
      "status": "目标",
      "given": "Engine中断前有任务已保存，尚有未完成任务",
      "expected": "Recover保留已存结果，未完成skipped，不自动Resume"
    },
    {
      "id": "A10",
      "status": "现有",
      "given": "同execution_request_id，相同参数且原Execution.finished",
      "expected": "返回原结果，不新增执行/任务结果"
    },
    {
      "id": "A11",
      "status": "现有",
      "given": "同execution_request_id，不同参数",
      "expected": "EXECUTION_REQUEST_CONFLICT；不覆盖旧请求"
    },
    {
      "id": "A12",
      "status": "目标",
      "given": "Planner旧回调，revision或active key或Intent hash不匹配",
      "expected": "拒绝业务提交；不能换取新key后重放"
    },
    {
      "id": "A13",
      "status": "目标",
      "given": "旧Execution回调，当前execution_id不同",
      "expected": "拒绝当前业务/Workflow写入；历史可读，不能覆盖新分支"
    },
    {
      "id": "A14",
      "status": "现有",
      "given": "旧report attempt finish=False",
      "expected": "不保存旧Report；旧Report Run不得complete，记录stale/interrupted"
    },
    {
      "id": "A15",
      "status": "目标",
      "given": "两个Session中的不同Workflow引用同一Plan locator",
      "expected": "拒绝跨Session/Workflow归属；不同Workflow可以各自version1"
    },
    {
      "id": "A16",
      "status": "目标",
      "given": "创建阶段尚无DatasetProfile/Plan/Approval/Execution",
