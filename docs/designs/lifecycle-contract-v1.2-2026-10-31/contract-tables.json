  "c19_commit_protocol": {
    "status": "目标",
    "accepted_definition": "业务事务已提交且持久Report/Generation/归属/提交元数据相互匹配",
    "commit_ack_lost": "重新读取事务一致的业务持久事实，匹配则accepted；未确认则unknown，不能因为无返回值标failed",
    "before_commit_authorization": "C19-A only; allow不是commit receipt",
    "observation": "C19-B only; accepted由持久证据推导，终结单一Span，不重开Root",
    "revision": "提交前authorized_revision，提交成功后committed_revision=authorized_revision+1；观测不要求当前active key仍保留，但要求提交时key与目标Span相符",
    "no_new_entity": "不新增Attempt/Trace层级/业务状态枚举；提交元数据建议存既有报告audit，尚不开发writer"
  }
