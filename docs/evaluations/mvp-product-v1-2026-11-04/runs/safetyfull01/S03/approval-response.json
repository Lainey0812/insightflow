      "tasks": [
        {
          "task_id": "T1",
          "title": "整体销售概况",
          "business_question": "销售数据的总体规模、订单数量及销售额分布特征是什么？",
          "priority": "P0",
          "priority_reason": "删除此任务将无法了解数据集的基本规模和核心指标（销售额）的整体水平，无法支撑对‘主要特征’的基础探索。",
          "requirement_ids": [
            "C01"
          ],
          "depends_on": [],
          "missing_inputs": [],
          "steps": [
            {
              "step_id": "S1",
              "operation": "aggregate",
              "params": {
                "metrics": [
                  {
                    "function": "count",
                    "field": null,
                    "alias": "total_order_count"
                  },
                  {
                    "function": "sum",
                    "field": "field_0005",
                    "alias": "total_sales_amount"
                  },
                  {
                    "function": "avg",
                    "field": "field_0005",
                    "alias": "avg_sales_amount"
                  }
                ]
              }
            }
          ]
        },
        {
          "task_id": "T2",
          "title": "地区维度差异分析",
          "business_question": "不同地区的订单数量和销售额存在哪些差异？",
          "priority": "P0",
          "priority_reason": "地区是主要的分组维度之一，删除此任务将缺失关键的地域性业务差异洞察，无法充分回答‘主要差异’这一核心问题。",
          "requirement_ids": [
            "C01"
          ],
          "depends_on": [],
          "missing_inputs": [],
          "steps": [
            {
              "step_id": "S1",
              "operation": "group_aggregate",
              "params": {
                "metrics": [
                  {
                    "function": "count",
                    "field": null,
                    "alias": "order_count_by_region"
                  },
                  {
                    "function": "sum",
                    "field": "field_0005",
                    "alias": "sales_sum_by_region"
                  }
                ],
                "dimensions": [
                  "field_0002"
                ]
              }
            },
            {
              "step_id": "S2",
              "operation": "sort",
              "params": {
                "field": "sales_sum_by_region",
                "direction": "desc"
              }
            }
          ]
        },
        {
          "task_id": "T3",
          "title": "产品类别差异分析",
          "business_question": "不同产品类别的销售表现（订单量与销售额）有何区别？",
          "priority": "P0",
          "priority_reason": "产品类别是另一个核心业务维度，用于识别品类间的贡献差异，属于探索数据主要特征的必要部分。",
          "requirement_ids": [
            "C01"
          ],
          "depends_on": [],
          "missing_inputs": [],
          "steps": [
            {
              "step_id": "S1",
              "operation": "group_aggregate",
              "params": {
                "metrics": [
                  {
                    "function": "count",
                    "field": null,
                    "alias": "order_count_by_category"
                  },
                  {
                    "function": "sum",
                    "field": "field_0005",
                    "alias": "sales_sum_by_category"
                  }
                ],
                "dimensions": [
                  "field_0007"
                ]
              }
            },
            {
              "step_id": "S2",
              "operation": "sort",
              "params": {
                "field": "sales_sum_by_category",
                "direction": "desc"
              }
            }
          ]
