                    "value": "2026-01-01"
                  },
                  {
                    "field": "field_0001",
                    "operator": "lt",
                    "value": "2027-01-01"
                  },
                  {
                    "field": "field_0002",
                    "operator": "eq",
                    "value": "华东地区"
                  },
                  {
                    "field": "field_0004",
                    "operator": "eq",
                    "value": "已完成"
                  }
                ]
