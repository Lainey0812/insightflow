      "tasks": [
        {
          "task_id": "T1",
          "title": "按项目统计任务数量与工时分布",
          "business_question": "各项目的任务数量是多少？各项目的平均工时、总工时及最大/最小工时分别是多少？",
          "priority": "P0",
          "priority_reason": "核心需求要求探索主要分布与差异。项目是数据中的关键维度，统计其任务量和工时指标能直接揭示不同项目间的资源投入和工作量差异，是回答‘主要分布’最基础且必要的视角。删除此任务将无法了解数据的核心结构。",
          "requirement_ids": [
            "C01"
          ],
          "depends_on": [],
          "missing_inputs": [],
          "steps": [
            {
              "step_id": "S1_1",
              "operation": "group_aggregate",
              "params": {
                "metrics": [
                  {
                    "function": "count",
                    "field": null,
                    "alias": "task_count"
                  },
                  {
                    "function": "sum",
                    "field": "field_0004",
                    "alias": "total_hours"
                  },
                  {
                    "function": "avg",
                    "field": "field_0004",
                    "alias": "avg_hours"
                  },
                  {
                    "function": "min",
                    "field": "field_0004",
                    "alias": "min_hours"
                  },
                  {
                    "function": "max",
                    "field": "field_0004",
                    "alias": "max_hours"
                  }
                ],
                "dimensions": [
                  "field_0002"
                ]
              }
            }
          ]
        },
        {
          "task_id": "T2",
          "title": "按状态统计任务数量与工时分布",
          "business_question": "各任务状态（如进行中、已完成等）的任务数量是多少？各状态下的平均工时和总工时有何差异？",
          "priority": "P0",
          "priority_reason": "状态是反映项目进展和执行情况的另一关键维度。通过对比不同状态下的任务量和工时，可以识别是否存在特定状态积压或某些状态耗时过长的问题，从而补充对‘主要差异’的探索。若缺失，将只看到静态的项目划分而忽略动态的执行阶段分布。",
          "requirement_ids": [
            "C01"
          ],
          "depends_on": [],
          "missing_inputs": [],
          "steps": [
            {
              "step_id": "S2_1",
              "operation": "group_aggregate",
              "params": {
                "metrics": [
                  {
                    "function": "count",
                    "field": null,
                    "alias": "status_task_count"
                  },
                  {
                    "function": "sum",
                    "field": "field_0004",
                    "alias": "status_total_hours"
                  },
                  {
                    "function": "avg",
                    "field": "field_0004",
                    "alias": "status_avg_hours"
                  }
                ],
                "dimensions": [
                  "field_0003"
                ]
              }
            }
          ]
        },
        {
          "task_id": "T3",
          "title": "整体工时概况与极值分析",
          "business_question": "所有任务的总体工时规模如何？单条任务工时的中位数、平均值以及最大值、最小值是多少？",
          "priority": "P1",
          "priority_reason": "提供全局基准线，帮助理解单个项目在整体中的相对位置。虽然分组分析（T1/T2）已包含部分聚合信息，但全局中位数对于判断工时分布的偏态（是否受极端值影响）具有独特价值，有助于更准确地解读T1和T2中的平均值差异。属于增强分析深度的补充性视角。",
          "requirement_ids": [
