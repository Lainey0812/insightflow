      "tasks": [
        {
          "task_id": "T1",
          "title": "2026年华东地区已完成订单销售额城市排名前三",
          "business_question": "在2026年、华东地区且状态为已完成的订单中，各城市的销售额总和是多少？按销售额降序排列取前三名。",
          "priority": "P0",
          "priority_reason": "直接回答核心分析目标：特定时间、区域、状态下的销售额分布及Top3排名。删除此任务将无法支持关于华东市场表现的核心决策。",
          "requirement_ids": [
            "C01",
            "C02",
            "C03",
            "C04",
            "C05"
          ],
          "depends_on": [],
          "missing_inputs": [],
          "steps": [
            {
              "step_id": "S1",
              "operation": "derive",
              "params": {
                "function": "extract_year",
                "field": "field_0001",
                "alias": "order_year"
              }
            },
            {
              "step_id": "S2",
              "operation": "filter",
              "params": {
                "conditions": [
                  {
                    "field": "order_year",
                    "operator": "eq",
                    "value": 2026
                  },
                  {
                    "field": "field_0002",
                    "operator": "eq",
                    "value": "华东"
                  },
                  {
                    "field": "field_0004",
                    "operator": "eq",
                    "value": "已完成"
                  }
                ]
              }
            },
            {
              "step_id": "S3",
              "operation": "group_aggregate",
              "params": {
                "metrics": [
                  {
                    "function": "sum",
                    "field": "field_0005",
                    "alias": "total_sales"
                  }
                ],
                "dimensions": [
                  "field_0003"
                ]
              }
            },
            {
              "step_id": "S4",
              "operation": "sort",
              "params": {
                "field": "total_sales",
                "direction": "desc"
              }
            },
            {
              "step_id": "S5",
              "operation": "top_n",
              "params": {
                "field": "total_sales",
                "direction": "desc",
                "n": 3
              }
            }
          ]
        }
      ],
