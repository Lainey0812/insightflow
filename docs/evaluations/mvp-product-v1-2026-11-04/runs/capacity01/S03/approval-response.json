      "tasks": [
        {
          "task_id": "T01",
          "title": "销售数据整体概况",
          "business_question": "当前数据集的总订单数、总销售额及平均单笔销售额是多少？",
          "priority": "P0",
          "priority_reason": "核心需求要求探索主要特征，整体规模（总量与均值）是理解数据分布的基础。删除此任务将无法回答“数据有多大”这一最基本问题。",
          "requirement_ids": [
            "C01"
          ],
          "depends_on": [],
          "missing_inputs": [],
          "steps": [
            {
              "step_id": "S01",
              "operation": "aggregate",
              "params": {
                "metrics": [
                  {
                    "function": "count",
                    "field": null,
                    "alias": "total_orders"
                  },
                  {
                    "function": "sum",
                    "field": "field_0005",
                    "alias": "total_sales_amount"
                  },
                  {
                    "function": "avg",
                    "field": "field_0005",
                    "alias": "avg_sales_per_order"
                  }
                ]
              }
            }
          ]
        },
        {
          "task_id": "T02",
          "title": "地区维度销售差异分析",
          "business_question": "不同地区的订单数量和销售总额分别是多少？哪个地区贡献最大？",
          "priority": "P0",
          "priority_reason": "核心需求要求探索“差异”，地区是主要地理维度。通过分组聚合可识别区域表现差异，支持资源分配或市场策略决策。",
          "requirement_ids": [
            "C01"
          ],
          "depends_on": [],
          "missing_inputs": [],
          "steps": [
            {
              "step_id": "S01",
              "operation": "group_aggregate",
              "params": {
                "metrics": [
                  {
                    "function": "count",
                    "field": null,
                    "alias": "order_count_by_region"
                  },
                  {
                    "function": "sum",
                    "field": "field_0005",
                    "alias": "sales_sum_by_region"
                  }
                ],
                "dimensions": [
                  "field_0002"
                ]
              }
            },
            {
              "step_id": "S02",
              "operation": "sort",
              "params": {
                "field": "sales_sum_by_region",
                "direction": "desc"
              }
            }
          ]
        },
        {
          "task_id": "T03",
          "title": "产品类别销售结构分析",
          "business_question": "各产品类别的销售总额和订单占比如何？哪类产品是主力？",
          "priority": "P1",
          "priority_reason": "补充性分析，用于细化业务维度差异。虽然对核心“主要特征”有帮助，但相比整体概况和地域差异，其优先级稍低，因为类别仅有两个值，区分度有限。",
          "requirement_ids": [
            "C01"
          ],
          "depends_on": [],
          "missing_inputs": [],
          "steps": [
            {
              "step_id": "S01",
              "operation": "group_aggregate",
              "params": {
                "metrics": [
                  {
                    "function": "sum",
