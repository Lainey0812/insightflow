                "field": "field_0002",
                "alias": "order_year"
              }
            },
            {
              "step_id": "S3",
              "operation": "filter",
              "params": {
                "conditions": [
                  {
                    "field": "order_year",
                    "operator": "eq",
                    "value": 2026
                  }
                ]
              }
            },
            {
              "step_id": "S4",
              "operation": "group_aggregate",
              "params": {
