{
  "$defs": {
    "AnalysisGoal": {
      "additionalProperties": false,
      "properties": {
        "analysis_object": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "pattern": "[\\s\\S]*\\S[\\s\\S]*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Analysis Object"
        },
        "business_goal": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "pattern": "[\\s\\S]*\\S[\\s\\S]*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Business Goal"
        },
        "decision_goal": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "pattern": "[\\s\\S]*\\S[\\s\\S]*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Decision Goal"
        }
      },
      "required": [
        "analysis_object",
        "business_goal",
        "decision_goal"
      ],
      "title": "AnalysisGoal",
      "type": "object"
    },
    "AnalysisMode": {
      "enum": [
        "goal_driven",
        "exploratory",
        "undetermined"
      ],
      "title": "AnalysisMode",
      "type": "string"
    },
    "DatasetRef": {
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "minLength": 1,
          "title": "Dataset Id",
          "type": "string"
        },
        "dataset_version": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Dataset Version",
          "type": "string"
        }
      },
      "required": [
        "dataset_id",
        "dataset_version"
      ],
      "title": "DatasetRef",
      "type": "object"
    },
    "IntentConstraints": {
      "additionalProperties": false,
      "properties": {
        "time_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/UnverifiedConstraint"
            },
            {
              "type": "null"
            }
          ]
        },
        "filters": {
          "items": {
            "$ref": "#/$defs/UnverifiedConstraint"
          },
          "title": "Filters",
          "type": "array"
        },
        "metric_requirements": {
          "items": {
            "$ref": "#/$defs/UnverifiedConstraint"
          },
          "title": "Metric Requirements",
          "type": "array"
        },
        "analysis_limits": {
          "items": {
            "$ref": "#/$defs/UnverifiedConstraint"
          },
          "title": "Analysis Limits",
          "type": "array"
        }
      },
      "required": [
        "time_range",
        "filters",
        "metric_requirements",
        "analysis_limits"
      ],
      "title": "IntentConstraints",
      "type": "object"
    },
    "LLMMetadata": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model"
        },
        "is_mock": {
          "title": "Is Mock",
          "type": "boolean"
        }
      },
      "required": [
        "provider",
        "model",
        "is_mock"
      ],
      "title": "LLMMetadata",
      "type": "object"
    },
    "Provenance": {
      "properties": {
        "source": {
          "default": "mock",
          "enum": [
            "mock",
            "uploaded",
            "llm",
            "input_guard"
          ],
          "title": "Source",
          "type": "string"
        },
        "dataset": {
          "default": "insightflow-demo-v1",
          "title": "Dataset",
          "type": "string"
        },
        "dataset_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Version"
        },
        "plan_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Version"
        },
        "notice": {
          "default": "Mock 示例，非上传文件分析结果",
          "title": "Notice",
          "type": "string"
        }
      },
      "title": "Provenance",
      "type": "object"
    },
    "Uncertainty": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "[\\s\\S]*\\S[\\s\\S]*",
          "title": "Id",
          "type": "string"
        },
        "issue": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "[\\s\\S]*\\S[\\s\\S]*",
          "title": "Issue",
          "type": "string"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "[\\s\\S]*\\S[\\s\\S]*",
          "title": "Reason",
          "type": "string"
        },
        "action": {
          "enum": [
            "clarify",
            "defer",
            "annotate"
          ],
          "title": "Action",
          "type": "string"
        },
        "resolve_at": {
          "enum": [
            "before_planning",
            "plan_approval",
            "before_execution"
          ],
          "title": "Resolve At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "issue",
        "reason",
        "action",
        "resolve_at"
      ],
      "title": "Uncertainty",
      "type": "object"
    },
    "UnverifiedConstraint": {
      "additionalProperties": false,
      "properties": {
        "raw_text": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "[\\s\\S]*\\S[\\s\\S]*",
          "title": "Raw Text",
          "type": "string"
        },
        "validation_status": {
          "const": "unverified",
          "title": "Validation Status",
          "type": "string"
        }
      },
      "required": [
        "raw_text",
        "validation_status"
      ],
      "title": "UnverifiedConstraint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analysis_mode": {
      "$ref": "#/$defs/AnalysisMode"
    },
    "next_action": {
      "enum": [
        "proceed",
        "clarify"
      ],
      "title": "Next Action",
      "type": "string"
    },
    "analysis_goal": {
      "$ref": "#/$defs/AnalysisGoal"
    },
    "constraints": {
      "$ref": "#/$defs/IntentConstraints"
    },
    "uncertainties": {
      "items": {
        "$ref": "#/$defs/Uncertainty"
      },
      "title": "Uncertainties",
      "type": "array"
    },
    "clarification_questions": {
      "items": {
        "maxLength": 2000,
        "minLength": 1,
        "pattern": "[\\s\\S]*\\S[\\s\\S]*",
        "type": "string"
      },
      "maxItems": 3,
      "title": "Clarification Questions",
      "type": "array"
    },
    "user_query": {
      "title": "User Query",
      "type": "string"
    },
    "clarification_answers": {
      "items": {
        "type": "string"
      },
      "title": "Clarification Answers",
      "type": "array"
    },
    "dataset_ref": {
      "$ref": "#/$defs/DatasetRef"
    },
    "parse_origin": {
      "enum": [
        "llm",
        "input_guard"
      ],
      "title": "Parse Origin",
      "type": "string"
    },
    "llm": {
      "anyOf": [
        {
          "$ref": "#/$defs/LLMMetadata"
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "parser_version": {
      "default": "1.0",
      "enum": [
        "1.0",
        "1.1"
      ],
      "title": "Parser Version",
      "type": "string"
    },
    "prompt_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Version"
    },
    "llm_attempts": {
      "anyOf": [
        {
          "maximum": 3,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Llm Attempts"
    },
    "parse_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parse Id"
    }
  },
  "required": [
    "analysis_mode",
    "next_action",
    "analysis_goal",
    "constraints",
    "uncertainties",
    "clarification_questions",
    "user_query",
    "clarification_answers",
    "dataset_ref",
    "parse_origin",
    "llm",
    "provenance"
  ],
  "title": "IntentArtifact",
  "type": "object"
}
