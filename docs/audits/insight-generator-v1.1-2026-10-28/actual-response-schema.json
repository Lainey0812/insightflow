            "maxLength": 2000,
            "minLength": 1,
            "pattern": "[\\s\\S]*\\S[\\s\\S]*",
            "type": "string"
          },
          "maxItems": 5,
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "primary_evidence_id",
        "evidence_refs",
        "finding_type",
        "implication",
        "recommendation",
        "limitations"
      ],
      "title": "DraftInsight",
      "type": "object"
