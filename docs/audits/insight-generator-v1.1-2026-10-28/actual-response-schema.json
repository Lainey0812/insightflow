          "type": "string",
          "enum": [
            "E0002",
            "E0003",
            "E0004",
            "E0005",
            "E0006",
            "E0007",
            "E0008"
          ]
        },
        "evidence_refs": {
          "items": {
            "maxLength": 120,
            "minLength": 1,
            "pattern": "[\\s\\S]*\\S[\\s\\S]*",
            "type": "string",
            "enum": [
              "E0002",
              "E0003",
              "E0004",
              "E0005",
              "E0006",
              "E0007",
              "E0008"
            ]
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
