# Export these variables before starting the backend or live evaluation.
# This file is a template only. Never commit actual credentials.
INSIGHTFLOW_DATA_DIR=../var
INSIGHTFLOW_LLM_BASE_URL=
INSIGHTFLOW_LLM_MODEL=
INSIGHTFLOW_LLM_API_KEY=
INSIGHTFLOW_LLM_TIMEOUT_SECONDS=30
INSIGHTFLOW_INTENT_MAX_ATTEMPTS=2
# Optional, Intent only: false for Qwen non-thinking extraction; blank omits the extension.
INSIGHTFLOW_INTENT_ENABLE_THINKING=
# Planner only; use false with current Qwen structured planning. Blank omits extension.
INSIGHTFLOW_PLANNER_ENABLE_THINKING=
INSIGHTFLOW_PLANNER_MAX_ATTEMPTS=2
# Trace metadata is isolated from business storage. No raw dataset/model text is retained.
INSIGHTFLOW_TRACE_ENABLED=true
# Explicit loopback-only testing access, including full request snapshots. Default false.
# Keep both backend and Admin bound to 127.0.0.1 when enabled. Never use in shared deployments.
INSIGHTFLOW_ADMIN_LOCAL_TEST_MODE=false
# Server-side read-only admin credential; blank disables Admin APIs unless local test mode is enabled. Never use VITE_.
INSIGHTFLOW_ADMIN_READ_TOKEN=
# Additional server-only credential for full LLM request reads; blank denies raw reads.
INSIGHTFLOW_ADMIN_SNAPSHOT_TOKEN=
# Optional positive days for raw LLM request retention. Blank preserves history until explicit policy change.
INSIGHTFLOW_LLM_REQUEST_RETENTION_DAYS=
